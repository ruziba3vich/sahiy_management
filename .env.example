# Database
DB_URL=postgres://postgres:postgres@localhost:5432/sahiy_management?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sahiy_management
DB_SSLMODE=disable

# App
PORT=8080

# JWT
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_EXPIRY_HOURS=24

# Docker (optional - for exposing postgres externally)
DB_EXTERNAL_PORT=5432
